# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://ast_user:ast_secure_password_2026@localhost:5432/ast_inventory_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="ast_super_secret_access_jwt_key_university_2026_devhub"
JWT_REFRESH_SECRET="ast_super_secret_refresh_jwt_key_university_2026_devhub"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Document Storage & Security
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage/documents"
SIGNED_URL_EXPIRATION_SECONDS=300

# AI / ML Service (Optional / Fallback)
AI_SERVICE_URL="http://localhost:8000"
ENABLE_AI_PREDICTIONS=true
